{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["es2023", "dom", "dom.iterable"],
        "types": ["vite/client", "node"],
        "allowImportingTsExtensions": true,
        // common-components/ has no node_modules: React's types come from this app (see reactAlias.ts).
        "paths": {
            "react": ["./node_modules/@types/react"],
            "react/*": ["./node_modules/@types/react/*"],
            "react-dom": ["./node_modules/@types/react-dom"],
            "react-dom/*": ["./node_modules/@types/react-dom/*"]
        }
    },
    "include": ["src", "vite.config.ts", "vitest.config.ts", "reactAlias.ts"],
    "references": [{ "path": "../../packages/core/tsconfig.src.json" }]
}
