{
    "name": "qualivis",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.18.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "pnpm --filter @qualivis/web dev",
        "build": "pnpm --filter @qualivis/web build",
        "preview": "pnpm --filter @qualivis/web preview",
        "start": "pnpm build && pnpm preview",
        "lint": "biome check .",
        "format": "biome check --write .",
        "typecheck": "pnpm -r --if-present run typecheck",
        "test": "vitest run",
        "test:parity": "vitest run --project core --project web golden",
        "check": "pnpm lint && pnpm typecheck && pnpm test",
        "legacy:extract": "node tools/legacy/extract-legacy-build.mjs",
        "legacy:serve": "node tools/legacy/serve-legacy.mjs",
        "knip": "knip"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/node": "catalog:",
        "knip": "6.45.1",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
