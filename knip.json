{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": ["legacy/**", "testdata/**", "tools/legacy/*.browser.js"],
    "ignoreDependencies": ["@fontsource/roboto", "@fontsource/material-icons"],
    "workspaces": {
        ".": {
            "entry": [
                "tools/**/*.mjs",
                "common-components/index.ts",
                "common-components/showcase/main.tsx",
                "common-components/vite.config.ts"
            ],
            "ignoreDependencies": ["@types/react", "@types/react-dom"]
        },
        "packages/core": {
            "ignore": ["src/legacy/**"],
            "includeEntryExports": true
        },
        "apps/web": {}
    }
}
